#!/usr/bin/env bash
set -euo pipefail

MSG_FILE="$1"
sed -i -E '/[Cc]o-authored-by:.*[Cc]ursor/d; /[Cc]ursor[ -][Aa]gent/d; /[Mm]ade[ -][Ww]ith.*[Cc]ursor/d' "$MSG_FILE"

FIRST_LINE="$(head -n 1 "$MSG_FILE" | tr -d '\r')"
if ! echo "$FIRST_LINE" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9_-]+\))?!?: .+'; then
  echo "Commit message must follow Conventional Commits format." >&2
  exit 1
fi
